@page "/estudiantes"
@rendermode InteractiveServer
@using Act15.Models
@using Act15.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>Gestión de Estudiantes</PageTitle>

<div class="container">
    <div class="header">
        <h1>🎓 Gestión de Estudiantes</h1>
        <p class="subtitle">Entity Framework Core · SQL Server · CRUD completo</p>
    </div>

    <!-- Alerta de mensaje -->
    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alerta @claseAlerta">@mensajeAlerta</div>
    }

    <!-- Formulario Registrar / Editar -->
    <div class="card form-card">
        <h2>@(modoEdicion ? "✏️ Editar Estudiante" : "➕ Registrar Estudiante")</h2>
        <EditForm Model="@estudianteActual" OnValidSubmit="GuardarEstudiante">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Nombre</label>
                <InputText class="form-control" @bind-Value="estudianteActual.Nombre" placeholder="Ej. Roberto García" />
                <ValidationMessage For="@(() => estudianteActual.Nombre)" class="error-msg" />
            </div>

            <div class="form-group">
                <label>Correo Electrónico</label>
                <InputText class="form-control" @bind-Value="estudianteActual.Correo" placeholder="Ej. roberto@gmail.com" />
                <ValidationMessage For="@(() => estudianteActual.Correo)" class="error-msg" />
            </div>

            <div class="form-group">
                <label>Calificación (0 – 10)</label>
                <InputNumber class="form-control" @bind-Value="estudianteActual.Calificacion" placeholder="Ej. 8.5" />
                <ValidationMessage For="@(() => estudianteActual.Calificacion)" class="error-msg" />
            </div>

            <div class="form-actions">
                @if (modoEdicion)
                {
                    <button type="button" class="btn-cancelar" @onclick="CancelarEdicion">✖ Cancelar</button>
                }
                <button type="submit" class="btn-guardar">
                    @(modoEdicion ? "💾 Actualizar" : "💾 Guardar")
                </button>
            </div>
        </EditForm>
    </div>

    <!-- Tabla de estudiantes -->
    <div class="card table-card">
        <h2>Lista de Estudiantes <span class="badge">@listaEstudiantes.Count</span></h2>

        @if (listaEstudiantes.Count == 0)
        {
            <div class="empty-state">
                <p>📋 No hay estudiantes registrados aún.</p>
                <small>Usa el formulario de arriba para registrar el primer estudiante.</small>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Calificación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var estudiante in listaEstudiantes)
                        {
                            <tr>
                                <td class="num">@estudiante.Id</td>
                                <td class="nombre">@estudiante.Nombre</td>
                                <td class="correo">@estudiante.Correo</td>
                                <td class="calificacion">
                                    <span class="cal-badge @GetCalificacionClase(estudiante.Calificacion)">
                                        @estudiante.Calificacion.ToString("0.##")
                                    </span>
                                </td>
                                <td class="acciones">
                                    <button class="btn-editar" @onclick="() => IniciarEdicion(estudiante)" title="Editar">✏️</button>
                                    <button class="btn-eliminar" @onclick="() => EliminarEstudiante(estudiante.Id)" title="Eliminar">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .container { max-width: 900px; margin: 0 auto; padding: 30px 20px; }

    .header { text-align: center; margin-bottom: 24px; }
    .header h1 {
        font-size: 2.1rem; font-weight: 700;
        background: linear-gradient(90deg, #a78bfa, #60a5fa, #34d399);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .subtitle { color: #94a3b8; margin-top: 6px; font-size: 0.9rem; }

    .alerta {
        border-radius: 10px; padding: 12px 18px; margin-bottom: 18px;
        font-size: 0.9rem; font-weight: 500;
    }
    .alerta-ok  { background: rgba(52,211,153,.15); color: #34d399; border: 1px solid rgba(52,211,153,.3); }
    .alerta-err { background: rgba(248,113,113,.15); color: #f87171; border: 1px solid rgba(248,113,113,.3); }

    .card {
        background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
        border-radius: 16px; padding: 26px; backdrop-filter: blur(12px);
        margin-bottom: 22px; box-shadow: 0 8px 32px rgba(0,0,0,.3);
    }
    .card h2 { color: #e2e8f0; font-size: 1.1rem; font-weight: 600; margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }

    .badge {
        background: linear-gradient(135deg,#a78bfa,#60a5fa); color: #fff;
        border-radius: 20px; padding: 2px 10px; font-size: .8rem; font-weight: 700;
    }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; color: #94a3b8; font-size: .82rem; font-weight: 600; margin-bottom: 5px; text-transform: uppercase; letter-spacing: .5px; }
    .form-control {
        width: 100%; padding: 11px 15px;
        background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
        border-radius: 10px; color: #e2e8f0; font-size: .93rem; font-family: 'Inter',sans-serif;
        outline: none; transition: all .2s;
    }
    .form-control:focus { border-color: #a78bfa; background: rgba(167,139,250,.1); box-shadow: 0 0 0 3px rgba(167,139,250,.15); }
    .form-control::placeholder { color: #475569; }
    .error-msg { color: #f87171; font-size: .82rem; margin-top: 4px; display: block; }

    .form-actions { margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px; }

    .btn-guardar {
        background: linear-gradient(135deg,#a78bfa,#60a5fa); color: #fff;
        border: none; border-radius: 10px; padding: 11px 26px;
        font-size: .93rem; font-weight: 600; font-family: 'Inter',sans-serif;
        cursor: pointer; transition: all .2s; box-shadow: 0 4px 15px rgba(167,139,250,.3);
    }
    .btn-guardar:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(167,139,250,.45); }

    .btn-cancelar {
        background: rgba(255,255,255,.08); color: #94a3b8;
        border: 1px solid rgba(255,255,255,.15); border-radius: 10px; padding: 11px 20px;
        font-size: .93rem; font-weight: 600; font-family: 'Inter',sans-serif; cursor: pointer; transition: all .2s;
    }
    .btn-cancelar:hover { background: rgba(255,255,255,.14); color: #e2e8f0; }

    .empty-state { text-align: center; padding: 36px; color: #64748b; }
    .empty-state p { font-size: 1rem; margin-bottom: 6px; }
    .empty-state small { font-size: .84rem; color: #475569; }

    .table-wrapper { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    thead tr { border-bottom: 1px solid rgba(255,255,255,.1); }
    th { color: #64748b; font-size: .77rem; font-weight: 600; text-transform: uppercase; letter-spacing: .8px; padding: 9px 13px; text-align: left; }
    tbody tr { border-bottom: 1px solid rgba(255,255,255,.05); transition: background .15s; }
    tbody tr:hover { background: rgba(255,255,255,.04); }
    td { padding: 11px 13px; color: #cbd5e1; font-size: .9rem; vertical-align: middle; }
    td.num { color: #475569; font-weight: 700; width: 50px; }
    td.nombre { font-weight: 600; color: #e2e8f0; }
    td.correo { color: #94a3b8; font-size: .86rem; }
    td.acciones { text-align: center; width: 90px; white-space: nowrap; }

    .cal-badge { display: inline-block; padding: 3px 11px; border-radius: 20px; font-weight: 700; font-size: .86rem; }
    .cal-alta  { background: rgba(52,211,153,.15); color: #34d399; border: 1px solid rgba(52,211,153,.3); }
    .cal-media { background: rgba(251,191,36,.15);  color: #fbbf24; border: 1px solid rgba(251,191,36,.3); }
    .cal-baja  { background: rgba(248,113,113,.15); color: #f87171; border: 1px solid rgba(248,113,113,.3); }

    .btn-eliminar, .btn-editar {
        border-radius: 8px; cursor: pointer; font-size: 1rem; padding: 4px 9px; transition: all .2s; border: none;
    }
    .btn-eliminar { background: rgba(248,113,113,.12); border: 1px solid rgba(248,113,113,.25); color: #f87171; margin-left: 4px; }
    .btn-eliminar:hover { background: rgba(248,113,113,.24); transform: scale(1.1); }
    .btn-editar   { background: rgba(96,165,250,.12);  border: 1px solid rgba(96,165,250,.25);  color: #60a5fa; }
    .btn-editar:hover   { background: rgba(96,165,250,.24);  transform: scale(1.1); }
</style>

@code {
    // ─── Estado ─────────────────────────────────────────────────────────────
    private Estudiante estudianteActual = new();
    private List<Estudiante> listaEstudiantes = new();
    private bool modoEdicion = false;
    private string mensajeAlerta = string.Empty;
    private string claseAlerta = string.Empty;

    // ─── Ciclo de vida ───────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    // ─── Leer (Read) ─────────────────────────────────────────────────────────
    private async Task CargarEstudiantes()
    {
        listaEstudiantes = await Db.Estudiantes.OrderBy(e => e.Id).ToListAsync();
    }

    // ─── Crear / Actualizar (Create / Update) ────────────────────────────────
    private async Task GuardarEstudiante()
    {
        if (modoEdicion)
        {
            Db.Estudiantes.Update(estudianteActual);
            await Db.SaveChangesAsync();
            MostrarAlerta("✅ Estudiante actualizado correctamente.", "alerta-ok");
        }
        else
        {
            Db.Estudiantes.Add(estudianteActual);
            await Db.SaveChangesAsync();
            MostrarAlerta("✅ Estudiante registrado correctamente.", "alerta-ok");
        }

        estudianteActual = new Estudiante();
        modoEdicion = false;
        await CargarEstudiantes();
    }

    // ─── Iniciar edición (Update) ────────────────────────────────────────────
    private void IniciarEdicion(Estudiante e)
    {
        estudianteActual = new Estudiante
        {
            Id          = e.Id,
            Nombre      = e.Nombre,
            Correo      = e.Correo,
            Calificacion = e.Calificacion
        };
        modoEdicion = true;
    }

    private void CancelarEdicion()
    {
        estudianteActual = new Estudiante();
        modoEdicion = false;
    }

    // ─── Eliminar (Delete) ───────────────────────────────────────────────────
    private async Task EliminarEstudiante(int id)
    {
        var e = await Db.Estudiantes.FindAsync(id);
        if (e != null)
        {
            Db.Estudiantes.Remove(e);
            await Db.SaveChangesAsync();
            MostrarAlerta("🗑️ Estudiante eliminado.", "alerta-err");
            await CargarEstudiantes();
        }
    }

    // ─── Helpers ─────────────────────────────────────────────────────────────
    private string GetCalificacionClase(double cal) => cal switch
    {
        >= 9 => "cal-alta",
        >= 7 => "cal-media",
        _    => "cal-baja"
    };

    private void MostrarAlerta(string mensaje, string clase)
    {
        mensajeAlerta = mensaje;
        claseAlerta   = clase;
    }
}
